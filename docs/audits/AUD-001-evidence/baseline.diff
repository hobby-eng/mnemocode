-  if (maximum === red) hue = ((green - blue) / delta) % 6;
-  else if (maximum === green) hue = (blue - red) / delta + 2;
-  else hue = (red - green) / delta + 4;
-  return ((hue * 60 + 360) % 360) + (1 - delta) * 0.01;
-}
