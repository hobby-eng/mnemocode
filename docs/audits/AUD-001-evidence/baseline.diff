-  const minimum = Math.min(mixed.red, mixed.green, mixed.blue);
-  const scaleUp = maximum < 0.30 ? 0.30 / maximum : 1;
-  const scaleDown = maximum > 0.82 ? 0.82 / maximum : 1;
-  const scale = Math.min(scaleUp, scaleDown);
-  return {
-    red: Math.min(1, Math.max(0, mixed.red * scale)),
-    green: Math.min(1, Math.max(0, mixed.green * scale)),
-    blue: Math.min(1, Math.max(0, mixed.blue * scale)),
