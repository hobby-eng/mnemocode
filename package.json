    "docs/*.md",
    "docs/releases/*.md",
    "docs/audits/README.md",
    "docs/audits/AUD-*.md",
    "docs/audits/AUD-*.json",
    "docs/audits/AUD-*-harnesses/*.{md,py,mjs,mts,ts,json,sh}",
    "docs/audits/AUD-007-harnesses/docker-shim/docker",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "check:toolchain": "node scripts/verify-toolchain.mjs",
    "check:markdown": "node scripts/verify-markdown.mjs",
    "check:audit-privacy": "node scripts/verify-audit-privacy.mjs",
    "check:audit-package": "node scripts/verify-audit-package.mjs",
    "check:copies": "node scripts/verify-no-copies.mjs",
    "check:code-rules": "node scripts/verify-code-rules.mjs",
    "check:rust": "cd sskr-wasm/rust && cargo clippy --locked --workspace --all-targets --target-dir ../../node_modules/.cache/sskr-cargo -- -D warnings && cargo fmt --all --check && cargo test --locked --workspace --all-targets --target-dir ../../node_modules/.cache/sskr-cargo && cargo test --locked --workspace --doc --target-dir ../../node_modules/.cache/sskr-cargo && cd ../.. && node scripts/sskr-licenses.mjs --check",
    "lint": "oxlint --type-aware --tsconfig tsconfig.tests.json --report-unused-disable-directives-severity=error src test scripts vitest.config.ts",
    "check": "pnpm check:toolchain && pnpm check:markdown && pnpm check:audit-privacy && pnpm check:audit-package && pnpm check:copies && pnpm check:code-rules && pnpm lint && pnpm check:rust && tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.cards.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=180000",
    "verify": "pnpm format:check && pnpm check && pnpm build && pnpm test",
    "build:executable": "node scripts/build-executable.mjs && node scripts/verify-executable.mjs",
    "build:sskr": "node scripts/build-sskr-wasm.mjs",
    "verify:sskr": "node scripts/build-sskr-wasm.mjs --check",
    "dev": "tsx src/mnemocode.ts"
  },
