{
  "name": "mnemocode",
  "version": "0.1.0",
  "packageManager": "pnpm@12.8.1",
  "private": true,
  "description": "Offline tool that writes a BIP39 mnemonic as numbers, Unicode codes or colors, masks it with dates you remember, splits it into Shamir shares, and prints QR codes and recovery cards",
  "type": "module",
  "bin": {
    "mnemocode": "./dist/mnemocode.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
