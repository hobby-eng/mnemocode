# Builds the SSKR engine, sskr-wasm/rust, into WebAssembly with pinned tools and no network.
# scripts/build-sskr-wasm.mjs runs it with sskr-wasm/rust as the build context and turns the
# output into sskr-wasm/generated. The image is x86-64 (linux/amd64) on every host.
#
# The toolchain stage is a word-for-word copy of the one in Dockerfile.reproducible of
# multi-chain-wallet-tools (revision 2d2b7cc): the same base image, clang, Rust and wasm-bindgen
# give the same bytes there and here, and Docker can reuse the layers it already built. Change it
# only together with that file.
FROM buildpack-deps:noble@sha256:cf0b8fb7b19c45ef68523a0c8a32a742b5f2c0839b1e8ca0061f73d6b1a19062 AS toolchain

ARG NODE_VERSION=26.10.0
ARG NODE_ARCHIVE_SHA256=ca70e9e349de048b9522abb3adc05b3bd6f43c5ffd3ec57916c7da292f59f022
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_INIT_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG CLANG_VERSION=1:18.0-59~exp2
ARG WASI_LIBC_VERSION=0.0~git20230113.4362b18-3

RUN apt-get update \
    && apt-get install --yes --no-install-recommends "clang=${CLANG_VERSION}" "wasi-libc=${WASI_LIBC_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    PATH=/root/.cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    CI=true \
    CFLAGS_wasm32_unknown_unknown="-I/usr/include/wasm32-wasi -include /usr/include/wasm32-wasi/string.h"

RUN curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      --output /tmp/node.tar.xz \
    && echo "${NODE_ARCHIVE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar --extract --xz --file /tmp/node.tar.xz --directory /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version \
    && npm --version

RUN curl --fail --silent --show-error --location \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
      --output /tmp/rustup-init \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain 1.99.0 --target wasm32-unknown-unknown \
    && rm /tmp/rustup-init \
    && cargo --version \
    && rustc --version

RUN git config --system http.version HTTP/1.1 \
    && npm install --global pnpm@12.8.1 \
    && cargo install wasm-bindgen-cli --version 0.2.129 --locked \
    && test "$(pnpm --version)" = '12.8.1' \
    && test "$(cargo --version | cut -d ' ' -f 1-2)" = 'cargo 1.99.0' \
    && test "$(wasm-bindgen --version | cut -d ' ' -f 1-2)" = 'wasm-bindgen 0.2.129'

FROM toolchain AS dependencies
# The folder that multi-chain-wallet-tools builds the same crate in, so that both builds see the
# same paths.
WORKDIR /workspace/packages/recovery-sskr-wasm/rust
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo fetch --locked

FROM dependencies AS built
# The flags of tooling/rust-toolchain.mjs and tooling/build-recovery-sskr-wasm.mjs in
# multi-chain-wallet-tools: Cargo and Rustup homes are written as /cargo and /rustup, and getrandom
# takes its randomness from the JavaScript host. Cargo reads the list separated by 0x1F (octal 037).
RUN --network=none \
    CARGO_ENCODED_RUSTFLAGS="$(printf '%s\037%s\037%s\037%s\037%s' \
      '--remap-path-prefix=/root/.cargo=/cargo' \
      '--remap-path-prefix=/root/.rustup=/rustup' \
      '--remap-path-prefix=/workspace=/workspace' \
      '--cfg' 'getrandom_backend="wasm_js"')" \
    cargo build --target wasm32-unknown-unknown --release --locked --offline \
    && wasm-bindgen target/wasm32-unknown-unknown/release/recovery_sskr_wasm.wasm \
      --target web --out-dir /output

FROM scratch AS output
COPY --from=built /output /
