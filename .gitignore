node_modules/
.pnpm-store/
dist/
# Single executables from scripts/build-executable.mjs; published only as release files.
release/
# A draft release downloaded to be OpenPGP-signed (scripts/sign-release.mjs).
release-signing-*/
coverage/
.DS_Store
output/
tmp/
export-*/
exports/
# A Cargo build of the SSKR engine's crate run by hand; pnpm check:rust builds in node_modules/.cache.
sskr-wasm/rust/target/
# Bytecode that Python writes beside the scripts and audit harnesses it imports.
__pycache__/

# Audit evidence stays local; only the harness scripts are published (docs/audits/README.md).
docs/audits/*-evidence/
